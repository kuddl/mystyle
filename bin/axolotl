#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { execSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const rootDir = path.resolve(__dirname, '..');
const portsDir = path.join(rootDir, 'ports');

const args = process.argv.slice(2);
const command = args[0];

function printHelp() {
  console.log(`
🦎 Axolotl CLI — Apply themes to your local tools

Usage:
  axolotl list                     List supported apps and flavors
  axolotl build                    Run theme generator for all ports
  axolotl apply herdr <flavor>     Apply theme to ~/.config/herdr/config.toml (CLI/TUI)
  axolotl apply herdr-app <flavor> Apply theme to Herdr Desktop App
  axolotl apply pi <flavor>        Apply theme to ~/.pi/agent/settings.json
  axolotl apply vscode <flavor>    Apply theme to VS Code User settings.json
  axolotl open raycast <flavor>    Trigger 1-click import into Raycast

Available Flavors:
  - obsidian (default)
  - natty
  - arcane
`);
}

if (!command || command === 'help' || command === '--help') {
  printHelp();
  process.exit(0);
}

if (command === 'list') {
  console.log(`
🎨 Axolotl Flavors:
  • obsidian  (Axolotl Obsidian — Pitch Black & Wizard Mint)
  • natty     (Axolotl Natty — Abyssal Navy & Natty Pink)
  • arcane    (Axolotl Arcane — Velvet Indigo & Electric Violet)

📦 Supported Ports:
  • raycast     (ports/raycast)
  • herdr       (ports/herdr — CLI / TUI)
  • herdr-app   (ports/herdr-app — Desktop App)
  • pi          (ports/pi — Pi Coding Agent TUI & Header)
  • vscode      (ports/vscode — Visual Studio Code Extension)
`);
  process.exit(0);
}

if (command === 'build') {
  console.log('Building all ports...');
  execSync(`node "${path.join(rootDir, 'generator', 'build.mjs')}"`, { stdio: 'inherit' });
  process.exit(0);
}

if (command === 'apply' || command === 'open') {
  const targetApp = args[1];
  const flavor = (args[2] || 'obsidian').toLowerCase();

  const validFlavors = ['obsidian', 'natty', 'arcane'];
  if (!validFlavors.includes(flavor)) {
    console.error(`❌ Invalid flavor: "${flavor}". Choose one of: ${validFlavors.join(', ')}`);
    process.exit(1);
  }

  if (targetApp === 'herdr') {
    applyHerdr(flavor);
  } else if (targetApp === 'herdr-app') {
    applyHerdrApp(flavor);
  } else if (targetApp === 'pi') {
    applyPi(flavor);
  } else if (targetApp === 'vscode') {
    applyVSCode(flavor);
  } else if (targetApp === 'raycast') {
    openRaycast(flavor);
  } else {
    console.error(`❌ Unknown app: "${targetApp}". Run "axolotl list" for available ports.`);
    process.exit(1);
  }
} else {
  console.error(`❌ Unknown command: "${command}"`);
  printHelp();
  process.exit(1);
}

function applyHerdr(flavor) {
  const configPath = path.join(os.homedir(), '.config', 'herdr', 'config.toml');
  const sourceSnippetPath = path.join(portsDir, 'herdr', `axolotl-${flavor}.toml`);

  if (!fs.existsSync(sourceSnippetPath)) {
    console.error(`❌ Theme snippet not found at: ${sourceSnippetPath}`);
    process.exit(1);
  }

  const snippet = fs.readFileSync(sourceSnippetPath, 'utf8');

  if (!fs.existsSync(configPath)) {
    fs.mkdirSync(path.dirname(configPath), { recursive: true });
    fs.writeFileSync(configPath, snippet);
    console.log(`✅ Created ${configPath} with Axolotl ${flavor}!`);
  } else {
    let existing = fs.readFileSync(configPath, 'utf8');

    // Remove existing [theme] and [theme.custom] sections
    // Match from [theme] until either next top-level [section] (not [theme.*]) or end of file
    const themeRegex = /\[theme\][\s\S]*?(?=\n\[(?!theme)[a-zA-Z0-9_.-]+\]|$)/;

    let updated;
    if (themeRegex.test(existing)) {
      updated = existing.replace(themeRegex, snippet.trim());
    } else {
      updated = existing.trim() + '\n\n' + snippet.trim() + '\n';
    }

    fs.writeFileSync(configPath, updated);
    console.log(`✅ Updated ${configPath} with Axolotl ${flavor}!`);
  }

  // Reload Herdr if server is running
  try {
    execSync('herdr server reload-config', { stdio: 'pipe' });
    console.log('🔄 Herdr server reloaded config successfully!');
  } catch {
    console.log('ℹ️ Herdr server is not currently running. Changes will apply on next launch.');
  }
}

function applyHerdrApp(flavor) {
  const destDir = path.join(os.homedir(), '.config', 'herdr-app', 'themes');
  fs.mkdirSync(destDir, { recursive: true });

  const themeSlug = `axolotl-${flavor}`;
  const srcFile = path.join(portsDir, 'herdr-app', `${themeSlug}.json`);
  const destFile = path.join(destDir, `${themeSlug}.json`);

  if (!fs.existsSync(srcFile)) {
    console.error(`❌ Theme file not found at: ${srcFile}`);
    process.exit(1);
  }

  fs.copyFileSync(srcFile, destFile);
  console.log(`✅ Installed theme to ${destFile}`);

  try {
    execSync(`herdr-app do app.theme '{"name":"${themeSlug}"}'`, { stdio: 'pipe' });
    console.log(`🔄 Herdr Desktop App switched to "${themeSlug}" successfully!`);
  } catch {
    console.log('ℹ️ Herdr Desktop App is not currently running. Theme is ready in Settings!');
  }
}

function applyPi(flavor) {
  const agentDir = path.join(os.homedir(), '.pi', 'agent');
  const themesDir = path.join(agentDir, 'themes');
  const extensionsDir = path.join(agentDir, 'extensions');
  const settingsPath = path.join(agentDir, 'settings.json');

  fs.mkdirSync(themesDir, { recursive: true });
  fs.mkdirSync(extensionsDir, { recursive: true });

  const themeSlug = `axolotl-${flavor}`;
  const srcThemeFile = path.join(portsDir, 'pi', `${themeSlug}.json`);
  const destThemeFile = path.join(themesDir, `${themeSlug}.json`);

  if (!fs.existsSync(srcThemeFile)) {
    console.error(`❌ Theme file not found at: ${srcThemeFile}`);
    process.exit(1);
  }

  // Copy all Axolotl themes to ~/.pi/agent/themes
  const piThemes = fs.readdirSync(path.join(portsDir, 'pi')).filter((f) => f.endsWith('.json'));
  for (const f of piThemes) {
    fs.copyFileSync(path.join(portsDir, 'pi', f), path.join(themesDir, f));
  }
  console.log(`✅ Copied Axolotl themes to ${themesDir}`);

  // Copy header extension
  const srcHeader = path.join(portsDir, 'pi', 'axolotl-header.ts');
  const destHeader = path.join(extensionsDir, 'axolotl-header.ts');
  if (fs.existsSync(srcHeader)) {
    fs.copyFileSync(srcHeader, destHeader);
    console.log(`✅ Installed Axolotl custom mascot header to ${destHeader}`);
  }

  // Update ~/.pi/agent/settings.json
  let settings = {};
  if (fs.existsSync(settingsPath)) {
    try {
      settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8'));
    } catch {
      settings = {};
    }
  }

  settings.theme = themeSlug;
  fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + '\n');
  console.log(`✅ Set Pi theme to "${themeSlug}" in ${settingsPath}`);
  console.log(`🦎 Pi is now themed with ${themeSlug}! Start or reload Pi to see your Axolotl header & colors.`);
}

function applyVSCode(flavor) {
  const srcExt = path.join(portsDir, 'vscode');
  const vsixFile = path.join(srcExt, 'axolotl-theme-0.1.0.vsix');

  // Build package if vsix missing or rebuild on apply
  try {
    execSync(`npx --yes @vscode/vsce package --no-git-tag-version --no-update-package-json`, {
      cwd: srcExt,
      stdio: 'pipe'
    });
    execSync(`code --install-extension "${vsixFile}" --force`, { stdio: 'pipe' });
    console.log(`✅ Installed Axolotl Theme Extension directly into VS Code!`);
  } catch (err) {
    console.warn(`⚠️ VSIX packaging fallback to directory copy: ${err.message}`);
    const extDir = path.join(os.homedir(), '.vscode', 'extensions', 'kuddl.axolotl-theme-0.1.0');
    fs.mkdirSync(extDir, { recursive: true });
    fs.cpSync(srcExt, extDir, { recursive: true });
  }

  // Update VS Code User settings.json and any profile settings.json
  const themeLabelMap = {
    obsidian: 'Axolotl Obsidian',
    natty: 'Axolotl Natty',
    arcane: 'Axolotl Arcane'
  };

  const themeLabel = themeLabelMap[flavor];

  const candidateSettings = [
    path.join(os.homedir(), 'Library', 'Application Support', 'Code', 'User', 'settings.json')
  ];

  const profilesDir = path.join(os.homedir(), 'Library', 'Application Support', 'Code', 'User', 'profiles');
  if (fs.existsSync(profilesDir)) {
    for (const p of fs.readdirSync(profilesDir)) {
      candidateSettings.push(path.join(profilesDir, p, 'settings.json'));
    }
  }

  for (const settingsPath of candidateSettings) {
    if (fs.existsSync(settingsPath)) {
      try {
        const content = fs.readFileSync(settingsPath, 'utf8');
        let updated;
        if (content.includes('"workbench.colorTheme"')) {
          updated = content.replace(/"workbench\.colorTheme"\s*:\s*"[^"]*"/, `"workbench.colorTheme": "${themeLabel}"`);
        } else {
          const lastBrace = content.lastIndexOf('}');
          if (lastBrace !== -1) {
            updated = content.slice(0, lastBrace).trimEnd() + `,\n  "workbench.colorTheme": "${themeLabel}"\n}\n`;
          }
        }
        if (updated) {
          fs.writeFileSync(settingsPath, updated);
          console.log(`✅ Set "workbench.colorTheme": "${themeLabel}" in ${settingsPath}`);
        }
      } catch (err) {
        console.warn(`⚠️ Could not update ${settingsPath}: ${err.message}`);
      }
    }
  }

  console.log(`🦎 VS Code is now configured with ${themeLabel}!`);
}

function openRaycast(flavor) {
  const raycastReadme = fs.readFileSync(path.join(portsDir, 'raycast', 'README.md'), 'utf8');
  const regex = new RegExp(`\\[\\x60(raycast:\\/\\/theme\\?[^\\x60]+)\\x60\\]`, 'g');
  const links = [];
  let m;
  while ((m = regex.exec(raycastReadme)) !== null) {
    links.push(m[1]);
  }

  const flavorIndex = { obsidian: 0, natty: 1, arcane: 2 }[flavor];
  const deeplink = links[flavorIndex];

  if (!deeplink) {
    console.error(`❌ Could not resolve deeplink for ${flavor}`);
    process.exit(1);
  }

  console.log(`🚀 Opening Raycast import for Axolotl ${flavor}...`);
  execSync(`open "${deeplink}"`);
}
