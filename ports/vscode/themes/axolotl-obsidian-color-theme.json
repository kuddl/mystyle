    "editor.selectionHighlightBackground": "#221D3A60",
    "editor.wordHighlightBackground": "#221D3A80",
    "editor.wordHighlightStrongBackground": "#221D3AB0",
    "editor.findMatchBackground": "#6AE5B540",
    "editor.findMatchHighlightBackground": "#5E26F630",
    "editorLineNumber.foreground": "#6E7185",
    "editorLineNumber.activeForeground": "#F4F4F6",
    "editorIndentGuide.background1": "#23232E",
    "editorIndentGuide.activeBackground1": "#6AE5B5",
    "editorWhitespace.foreground": "#6E718540",
    "editorLink.activeForeground": "#56B7EC",
    "editorError.foreground": "#FF5C77",
    "editorWarning.foreground": "#F3F99D",
    "editorInfo.foreground": "#56B7EC",
    "editorGroupHeader.tabsBackground": "#121217",
    "tab.activeBackground": "#09090B",
