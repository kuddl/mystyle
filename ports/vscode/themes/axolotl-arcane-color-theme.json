    "input.placeholderForeground": "#746E96",
    "inputOption.activeBorder": "#7C4DFF",
    "list.activeSelectionBackground": "#281E42",
    "list.activeSelectionForeground": "#BCB8CE",
    "list.inactiveSelectionBackground": "#281E4280",
    "list.inactiveSelectionForeground": "#BCB8CE",
    "list.hoverBackground": "#281E4250",
    "list.hoverForeground": "#BCB8CE",
    "list.focusBackground": "#281E42",
    "list.highlightForeground": "#7C4DFF",
    "scrollbarSlider.background": "#746E9630",
    "scrollbarSlider.hoverBackground": "#746E9650",
    "scrollbarSlider.activeBackground": "#746E9680",
    "badge.background": "#7C4DFF",
    "badge.foreground": "#FFFFFF",
    "button.background": "#7C4DFF",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#72F1B8",
    "gitDecoration.modifiedResourceForeground": "#FF85B8",
    "gitDecoration.deletedResourceForeground": "#FF6384",
    "gitDecoration.untrackedResourceForeground": "#72F1B8",
    "gitDecoration.ignoredResourceForeground": "#746E96",
    "gitDecoration.conflictingResourceForeground": "#FFE699",
    "terminal.background": "#0D0B14",
    "terminal.foreground": "#BCB8CE",
    "terminal.ansiBlack": "#0D0B14",
    "terminal.ansiRed": "#FF6384",
    "terminal.ansiGreen": "#72F1B8",
    "terminal.ansiYellow": "#FFE699",
    "terminal.ansiBlue": "#68C3F8",
    "terminal.ansiMagenta": "#FF85B8",
    "terminal.ansiCyan": "#7EE2ED",
    "terminal.ansiWhite": "#CFCBE2",
    "terminal.ansiBrightBlack": "#524B70",
    "terminal.ansiBrightRed": "#FF829D",
    "terminal.ansiBrightGreen": "#8FF7C8",
    "terminal.ansiBrightYellow": "#FFEDB5",
    "terminal.ansiBrightBlue": "#8AD2FA",
    "terminal.ansiBrightMagenta": "#FFA3CA",
    "terminal.ansiBrightCyan": "#9BEBF4",
    "terminal.ansiBrightWhite": "#BCB8CE"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#746E96",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Operators",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FF85B8"
      }
    },
    {
      "name": "Storage & Types",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#9E7BFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#68C3F8"
      }
    },
    {
      "name": "Strings & Template Expressions",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#72F1B8"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFE699"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#BCB8CE"
      }
    },
    {
      "name": "HTML/JSX Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF85B8"
      }
    },
    {
      "name": "HTML/JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFE699",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9E99B5"
      }
    },
    {
      "name": "JSON/Object Keys",
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml",
        "constant.other.object.key.js"
      ],
      "settings": {
        "foreground": "#68C3F8"
      }
    }
  ]
}
