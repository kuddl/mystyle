    "titleBar.activeBackground": "#161324",
    "titleBar.activeForeground": "#BCB8CE",
    "titleBar.inactiveBackground": "#161324",
    "titleBar.inactiveForeground": "#746E96",
    "titleBar.border": "#2A2440",
    "statusBar.background": "#161324",
    "statusBar.foreground": "#9E99B5",
    "statusBar.border": "#2A2440",
    "statusBar.debuggingBackground": "#7C4DFF",
