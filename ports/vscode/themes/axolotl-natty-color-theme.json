    "editorCursor.foreground": "#FF75B5",
    "editor.lineHighlightBackground": "#141824",
    "editor.selectionBackground": "#261E3FB0",
    "editor.selectionHighlightBackground": "#261E3F60",
    "editor.wordHighlightBackground": "#261E3F80",
    "editor.wordHighlightStrongBackground": "#261E3FB0",
    "editor.findMatchBackground": "#FF75B540",
    "editor.findMatchHighlightBackground": "#7C3AED30",
    "editorLineNumber.foreground": "#6E7C91",
    "editorLineNumber.activeForeground": "#EEFFFF",
    "editorIndentGuide.background1": "#232A40",
    "editorIndentGuide.activeBackground1": "#FF75B5",
    "editorWhitespace.foreground": "#6E7C9140",
    "editorLink.activeForeground": "#89DDFF",
    "editorError.foreground": "#FF5C57",
    "editorWarning.foreground": "#F3F99D",
    "editorInfo.foreground": "#89DDFF",
    "editorGroupHeader.tabsBackground": "#141824",
