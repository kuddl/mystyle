    "tab.border": "#232A40",
    "tab.activeBorder": "#FF75B5",
    "titleBar.activeBackground": "#141824",
    "titleBar.activeForeground": "#EEFFFF",
    "titleBar.inactiveBackground": "#141824",
    "titleBar.inactiveForeground": "#6E7C91",
    "titleBar.border": "#232A40",
    "statusBar.background": "#141824",
    "statusBar.foreground": "#B7C5D3",
    "statusBar.border": "#232A40",
    "statusBar.debuggingBackground": "#FF75B5",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#141824",
    "editorWidget.background": "#1C2233",
    "editorWidget.border": "#232A40",
    "editorHoverWidget.background": "#1C2233",
    "editorHoverWidget.border": "#232A40",
    "dropdown.background": "#1C2233",
    "dropdown.border": "#232A40",
    "dropdown.foreground": "#EEFFFF",
    "input.background": "#1C2233",
    "input.border": "#232A40",
    "input.foreground": "#EEFFFF",
    "input.placeholderForeground": "#6E7C91",
    "inputOption.activeBorder": "#FF75B5",
    "list.activeSelectionBackground": "#261E3F",
    "list.activeSelectionForeground": "#EEFFFF",
    "list.inactiveSelectionBackground": "#261E3F80",
    "list.inactiveSelectionForeground": "#EEFFFF",
    "list.hoverBackground": "#261E3F50",
    "list.hoverForeground": "#EEFFFF",
    "list.focusBackground": "#261E3F",
    "list.highlightForeground": "#FF75B5",
    "scrollbarSlider.background": "#6E7C9130",
    "scrollbarSlider.hoverBackground": "#6E7C9150",
    "scrollbarSlider.activeBackground": "#6E7C9180",
    "badge.background": "#FF75B5",
    "badge.foreground": "#FFFFFF",
    "button.background": "#FF75B5",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#5AF78E",
    "gitDecoration.modifiedResourceForeground": "#FF75B5",
    "gitDecoration.deletedResourceForeground": "#FF5C57",
    "gitDecoration.untrackedResourceForeground": "#5AF78E",
    "gitDecoration.ignoredResourceForeground": "#6E7C91",
    "gitDecoration.conflictingResourceForeground": "#F3F99D",
    "terminal.background": "#0C0E16",
    "terminal.foreground": "#EEFFFF",
    "terminal.ansiBlack": "#0C0E16",
    "terminal.ansiRed": "#FF5C57",
    "terminal.ansiGreen": "#5AF78E",
    "terminal.ansiYellow": "#F3F99D",
    "terminal.ansiBlue": "#94D0FF",
    "terminal.ansiMagenta": "#FF75B5",
    "terminal.ansiCyan": "#89DDFF",
    "terminal.ansiWhite": "#B7C5D3",
    "terminal.ansiBrightBlack": "#4B5672",
    "terminal.ansiBrightRed": "#FF7A76",
    "terminal.ansiBrightGreen": "#7BFAA5",
    "terminal.ansiBrightYellow": "#F7FCB5",
    "terminal.ansiBrightBlue": "#AEE0FF",
    "terminal.ansiBrightMagenta": "#FF94C6",
    "terminal.ansiBrightCyan": "#A6E6FF",
    "terminal.ansiBrightWhite": "#EEFFFF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E7C91",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Operators",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FF75B5"
      }
    },
    {
      "name": "Storage & Types",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#89DDFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#94D0FF"
      }
    },
    {
      "name": "Strings & Template Expressions",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5AF78E"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F3F99D"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#EEFFFF"
      }
    },
    {
      "name": "HTML/JSX Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF75B5"
      }
    },
    {
      "name": "HTML/JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F3F99D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B7C5D3"
      }
    },
    {
      "name": "JSON/Object Keys",
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml",
        "constant.other.object.key.js"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    }
  ]
}
